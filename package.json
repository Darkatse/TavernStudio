{
  "name": "tavern-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tavern-studio/studio dev",
    "build": "pnpm --filter @tavern-studio/studio build",
    "check": "pnpm run check:types && pnpm run check:lint && pnpm run check:format && pnpm run build",
    "check:types": "tsc -p apps/studio",
    "check:lint": "oxlint --type-aware --deny-warnings",
    "check:format": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  }
}
